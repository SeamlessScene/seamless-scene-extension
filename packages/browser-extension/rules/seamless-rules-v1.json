{
  "rules_version": "1.3.0",
  "about": "Seamless Scene edit rules: the single source for the extension's and the website's edit checks. Generated outputs: the extension's src/seamless-rules.mjs, the website's edit-pack schema and rules/vectors/boundaries-v1.json (npm run build:rules; npm run check:rules compares). Profiles: local-user (.ss files, folders, edit packs), catalog-v2 (published catalog edits), mvp (legacy signed 1.0.0 manifests). A relaxation that older clients would refuse names the first extension version that accepts it (requires_client).",
  "clip": {
    "duration_ms": {
      "local-user": { "min": 1500, "max": 120000 },
      "catalog-v2": { "min": 1500, "max": 120000 },
      "mvp": { "min": 5000, "max": 60000 }
    },
    "duration_tolerance_ms": 100,
    "dimensions": { "min": [320, 180], "max": [4096, 2160], "even": true },
    "bytes": { "local-user": 536870912, "catalog-v2": 250000000 },
    "count": { "local-user": 1000, "catalog-v2": 200 }
  },
  "segments": { "local-user": 1000, "catalog-v2": 200, "mvp": 1000, "gain_db": [-24, 6], "chain_gap_ms": 50, "risky_gap_ms": [50, 500] },
  "source": {
    "service": "prime-video",
    "territory": "^[A-Z]{2}$",
    "tiers": ["ad-free", "ad-supported"],
    "local_tiers": ["ad-free", "ad-supported", "unverified"],
    "local_default_tier": "unverified",
    "local_unknown_territory": "ZZ",
    "version_tag": { "pattern": "^[a-z0-9][a-z0-9._-]*$", "max": 120 },
    "season": [0, 10000],
    "episode": [0, 10000],
    "runtime_ms": [1000, 86400000],
    "tolerance_ms": { "max": 5000, "default": 3000, "match_floor": 2500, "legacy_read_max": 10000 }
  },
  "relaxations": [
    { "id": "clip-under-5000", "profile": "local-user", "below_ms": 5000, "requires_client": "0.64.2", "since_rules": "1.0.0" },
    { "id": "clip-under-5000", "profile": "catalog-v2", "below_ms": 5000, "requires_client": "0.65.0", "since_rules": "1.1.0" },
    { "id": "season-or-episode-0", "profile": "local-user", "requires_client": "0.65.0", "since_rules": "1.1.0" }
  ],
  "listing": {
    "title": [3, 120],
    "description": [20, 5000],
    "categories": {
      "casting-swap": "Casting Swap", "visual-fx-update": "Visual FX Update", "outfit-swap": "Outfit Swap",
      "parody": "Parody", "major-rewrite": "Major Rewrite", "extended-scene": "Extended Scene", "other": "Other"
    },
    "legacy_categories": ["restoration", "narrative-change", "removal-filter", "casting-character", "visual-treatment", "tone-localization"],
    "tags": { "max": 5, "length": [1, 40] },
    "release_notes_max": 4000,
    "imdb": { "pattern": "^https:\\/\\/(?:www\\.|m\\.)?imdb\\.com\\/title\\/tt\\d{7,10}\\/?(?:[?#].*)?$", "max": 300 }
  },
  "archive": {
    "total_bytes": 2147483648,
    "json_bytes": 1048576,
    "details_bytes": 65536,
    "json_depth": 64,
    "ratio": { "clip": 50, "other": 200, "exempt_below": 1048576 },
    "min_extension": "0.63.0"
  },
  "catalog": { "packet_schema": "2.0.0", "media_profile": "catalog-av-v2", "min_client": "0.42.0", "total_bytes": 2000000000 }
}
