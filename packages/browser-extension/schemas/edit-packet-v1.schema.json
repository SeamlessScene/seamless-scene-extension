{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scene-substitution.invalid/schemas/edit-packet-v1.schema.json",
  "title": "Local edit packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_schema_version", "packet_id", "purpose", "manifest", "asset_bindings"],
  "properties": {
    "packet_schema_version": { "const": "1.0.0" },
    "packet_id": { "$ref": "#/$defs/id" },
    "purpose": { "const": "local-research" },
    "manifest": { "$ref": "manifest-v1.schema.json" },
    "asset_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/assetBinding" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "assetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "relative_path"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "relative_path": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*\\.mp4$"
        }
      }
    }
  }
}
